# URL del backend (FastAPI). Se copia a .env (desarrollo) o se inyecta al compilar (APK).
# EXPO_PUBLIC_* queda VISIBLE dentro de la app: no pongas claves ni credenciales.
#
# Desarrollo web / simulador iOS (mismo equipo):
EXPO_PUBLIC_API_URL=http://localhost:8000
# Emulador de Android: http://10.0.2.2:8000 (si se omite en desarrollo, se usa ese valor)
# Teléfono físico en la misma red (arrancar el backend con --host 0.0.0.0):
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
# Producción / APK: HTTPS obligatorio y NUNCA localhost, p. ej.:
#   EXPO_PUBLIC_API_URL=https://api.tu-dominio.example
