{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "ANDROID_ALLOW_CLEARTEXT": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "ANDROID_ALLOW_CLEARTEXT": "1"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "ANDROID_ALLOW_CLEARTEXT": "0",
        "EXPO_PUBLIC_API_URL": "https://nawi-narino-api.onrender.com"
      }
    }
  }
}
