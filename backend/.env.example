APP_NAME=Nawi-Narino API
ENVIRONMENT=development
DATA_SOURCE=mock
# Set DATA_SOURCE=database and provide a local PostgreSQL URL only when needed.
DATABASE_URL=
CORS_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081"]


# Autenticación: genera uno con  python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET=
ACCESS_TOKEN_MINUTES=10080

# Generación con una API externa (Groq) en lugar de Ollama local. La clave SOLO en el servidor.
# RAG_GEN_PROVIDER=api
# RAG_GEN_API_URL=https://api.groq.com/openai/v1
# RAG_GEN_API_KEY=
# RAG_GEN_MODEL=llama-3.3-70b-versatile
